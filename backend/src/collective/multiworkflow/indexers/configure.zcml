<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Indexers/Metadata -->

  <!-- Shadows the workflow variable of the same name: plone.indexer's wrapper
       asks for an IIndexer adapter before it looks at workflow variables, so
       the catalog sees the whole chain rather than one workflow's state. -->
  <adapter
      factory=".workflow_states.workflow_states"
      name="workflow_states"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>
